{
  "name": "@mystock/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node -e \"require('node:fs').rmSync('allure-results',{recursive:true,force:true})\" && playwright test",
    "test:e2e:local": "node -e \"require('node:fs').rmSync('allure-results',{recursive:true,force:true})\" && playwright test -c playwright.local-stack.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "allure:serve": "allure serve allure-results"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@mystock/contracts": "0.0.0",
    "@mystock/domain": "0.0.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.0",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
