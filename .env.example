# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# Server-only secrets (DATABASE_URL) must never be
# prefixed with VITE_ and must never reach the browser bundle.
#
# Every variable below is validated by packages/config/src/env.ts at API boot;
# an invalid value stops the process and names the failing keys.
# Values marked "production" are what a real deployment needs; the defaults
# shown are for local development.
# ---------------------------------------------------------------------------

# development | test | production. Production additionally requires DATABASE_SSL=true.
NODE_ENV=development

# fatal | error | warn | info | debug | trace. Keep info or warn in production.
LOG_LEVEL=debug

# --- API ---------------------------------------------------------------
# Port the API listens on. Health probes: /health, /health/live, /health/ready.
API_PORT=4100

# Exact browser origin, no trailing slash and no path, e.g. https://app.example.com.
# Used for CORS; a mismatch looks like a blocked sign-in, not a config error.
WEB_ORIGIN=http://localhost:5173

# --- Supabase project --------------------------------------------------
# Project settings -> API. Only the public anon key belongs here; the service-role
# key is not used by this API and must never be placed in a VITE_* variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# At least 20 characters or boot fails.
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# JWT validation (Auth -> JWT settings). Must match the issuer the tokens carry,
# i.e. SUPABASE_URL plus /auth/v1.
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# --- Database ----------------------------------------------------------
# postgres:// or postgresql:// only. This is an administration-capable credential:
# keep it out of logs, chat, commits, and the browser bundle.
#
# Two hosts can serve this project:
#   * Session pooler (recommended for the API and for `supabase db push` when the
#     network has no IPv6 route):
#     host aws-0-<region>.pooler.supabase.com, port 5432,
#     user postgres.<project-ref>, database postgres, sslmode=require
#   * Direct host db.<project-ref>.supabase.co:5432 — IPv6-only for this project,
#     so it fails silently on an IPv4-only network.
#
# The 5432 endpoint is Supabase's *session* pooler, so it behaves like a direct
# connection. Do not point DATABASE_URL at the 6543 *transaction* pooler: the API and
# the RPCs set session-local GUCs (request.jwt.claims) inside transactions, and a
# transaction pooler reassigns connections between statements.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# true (default) | false. Must stay true in production: the schema is only reachable
# over TLS, and the config refuses to start a production process with DATABASE_SSL=false.
# Set to false only for a local PostgreSQL instance without TLS (tests, drills).
DATABASE_SSL=true

# --- Rate limiting -----------------------------------------------------
# Per-instance in-memory counter window. If more than one API instance is planned, the
# store has to become distributed before these numbers mean a global limit.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

# --- Web (Vite exposes only VITE_* to the browser) ---------------------
# Public by design: anything you put here is readable in the delivered bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# API base URL the browser calls; include the version prefix, no trailing slash.
VITE_API_BASE_URL=http://localhost:4100/api/v1

# --- Loading order (apps/api/src/config/env.tokens.ts) -----------------
# The API reads apps/api/.env first, then the repository root .env, and dotenv never
# overrides a variable already present in the process environment. An explicit
# DATABASE_URL in the shell, service unit, or CI job therefore wins over the root .env.
