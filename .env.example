# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# Server-only secrets (DATABASE_URL) must never be
# prefixed with VITE_ and must never reach the browser bundle.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---------------------------------------------------------------
API_PORT=4100
WEB_ORIGIN=http://localhost:5173

# --- Supabase project --------------------------------------------------
# Project settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# JWT validation (Auth -> JWT settings)
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# --- Database ----------------------------------------------------------
# Direct connection (port 5432) for migrations and integration tests.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Set to false only for a local PostgreSQL instance without TLS.
DATABASE_SSL=true

# --- Rate limiting -----------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120

# --- Web (Vite exposes only VITE_* to the browser) ---------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_API_BASE_URL=http://localhost:4100/api/v1
